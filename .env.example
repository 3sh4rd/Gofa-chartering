# Copy this file to ".env" and fill in your real values.
# Never commit the real .env file (it is git-ignored).

# Where booking/contact submissions are sent:
TO_EMAIL=gofabahamas@gmail.com

# Port the server runs on:
PORT=3000

# --- SMTP (outgoing email) -------------------------------------------------
# For Gmail: turn on 2-Step Verification, then create an "App Password"
# (Google Account > Security > App passwords) and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=gofabahamas@gmail.com
SMTP_PASS=your-16-char-app-password
